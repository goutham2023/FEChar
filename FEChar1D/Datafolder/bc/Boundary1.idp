// =============================================================================
// Boundary1.idp  --  time histories of the heating at the front (heated) face
// -----------------------------------------------------------------------------
// All histories in the standard FEChAR benchmarks have the same shape: a
// trapezoidal pulse ("ramp"). One generic macro, pulse(t), describes that shape
// and every boundary condition is "base + (peak - base) x pulse(t)".
//
//   value
//    peak |            ______________________
//         |           /                      \
//         |          /                        \
//    base |_________/                          \_________________
//         +---------+--------------------------+--+---------------> t
//         0     tRampUp                  tRampOff  tRampOff+tRampDown
//
// The ramp parameters (tRampUp, tRampOff, tRampDown) and the peak values
// (reuechPeak, HrPeak, qconvPeak, TwPeak) are set in params.idp.
// Edit them THERE; this file normally does not need to change.
//
// This file must be saved with Unix (LF) line endings (see .gitattributes).
// =============================================================================

// pulse(t): dimensionless trapezoid, 0 -> 1 over tRampUp [s], held at 1 until
//           tRampOff [s], then 1 -> 0 over tRampDown [s], and 0 afterwards.
macro pulse(tt)
(
  ((tt) >= tRampOff + tRampDown) ? 0. :
  (((tt) >= tRampOff) ? 1. - ((tt) - tRampOff) / tRampDown :
  (((tt) >= tRampUp) ? 1. : (tt) / tRampUp))
)//

// ---- bcType = 0 : prescribed wall temperature [K]  (Dirichlet) --------------
// Rises from the ambient temperature Tamb2 to TwPeak and returns to Tamb2.
macro Tnew(tt) ( Tamb2 + (TwPeak - Tamb2) * pulse(tt) )//

// ---- bcType = 1 : aerothermal edge condition, solved with the B' tables -----
// rho_e*u_e*C_H : edge mass-transfer coefficient [kg/m^2/s]
macro reuechbc(tt) ( reuechPeak * pulse(tt) )//
// H_r : recovery enthalpy [J/kg]; the plateau HrPeak is chosen by `heatbc`
macro Hrbc(tt) ( HrPeak * pulse(tt) )//

// ---- bcType = 2 : prescribed net wall heat flux [W/m^2] ---------------------
// Replace this macro by any q(t) you already have (e.g. from a CFD analysis).
macro qconvbc(tt) ( qconvPeak * pulse(tt) )//
