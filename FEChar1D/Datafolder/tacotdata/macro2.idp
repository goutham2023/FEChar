macro savetecplot3(Th,namef,v1in,v2in,v3in,cv1,cv2,cv3,zname)
{
   ofstream ftec(namef+".dat");
   ftec<<"VARIABLES= x y "<<cv1<<" "<<cv2<<" "<<cv3<<endl;
   ftec<<"ZONE T=\""<<zname<<"\", F=FEPOINT, N="<<Th.nv<<", E="<<Th.nt<<", ET=TRIANGLE"<<endl;
   real[int] Thnv(Th.nv);
   for[i,Thnvi:Thnv]
      ftec<<Th(i).x<<" "<<Th(i).y<<" "<<v1in[][i]<<" "<<v2in[][i]<<" "<<v3in[][i]<<endl;
   ftec<<endl;
   /* connectivites */
   real[int] Thnt(Th.nt);
   for[i,Thnti:Thnt]
      ftec<< Th[i][0]+1 <<" "<< Th[i][1]+1 <<" "<< Th[i][2]+1 <<endl;
   cout<<" +++++++++ savetec3var :: file "<<namef+".dat"<<endl;
}// EOM


