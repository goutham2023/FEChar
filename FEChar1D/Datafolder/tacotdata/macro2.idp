//porous flow properties
real kpc=2e-11;
real kpv=1.6e-11;
macro kpcal(x)
(
  kpv*(1-x)+kpc*x
)//
// macro kpcal(x)
// (
//     (x>0.98) ? kpc :kpv
// )// 

real phiv=0.8;
// real phic=0.842;
real phic=0.85;
macro phical(x)
(
  phiv*(1-x)+phic*x

)//

