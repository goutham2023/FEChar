// =============================================================================
// macro2.idp  --  TACOT material model
// -----------------------------------------------------------------------------
// Everything the solver needs to know about the MATERIAL lives in this file
// (plus the property tables materialprop.dat and pyrogas_prop.txt):
//
//   1. Pyrolysis (resin decomposition) kinetics  : denvarA / denvarB / denvarC
//   2. Surface emissivity                        : emmisivity(rho)
//   3. Virgin / char solid properties            : cpv kv hv  and  cpc kc hc
//   4. Virgin <-> char blending weight           : wf(rho)
//   5. Porous-flow properties (permeability,
//      porosity) vs. extent of pyrolysis alpha   : kpcal(alpha), phical(alpha)
//   6. 1-D linear table interpolation            : intrp(Z, X, Y, n)
//
// To use another material, replace the contents of this file (keep the same
// macro names) and the two property tables.  main.edp does not change.
// All quantities are SI: K, kg/m^3, J/kg, J/kg/K, W/m/K, m^2, Pa.
//
// NOTE: this file must be saved with Unix (LF) line endings. Windows (CRLF)
// line endings break FreeFEM macros on Linux/macOS (see .gitattributes).
// =============================================================================

// -----------------------------------------------------------------------------
// 1. Pyrolysis kinetics
//    The virgin composite is split into three constituents (A, B, C) that
//    decompose independently with an nth-order Arrhenius law (n = 3 for A, B).
//    C (the reinforcement) does not decompose.  main.edp advances
//        rho_i(t+dt) = rho_i(t) + denvar_i(T, rho_i) * dt
//    Arguments: x = temperature [K],  y = current constituent density [kg/m^3]
// -----------------------------------------------------------------------------
macro denvarA( x, y)
  (
    (x>333.33)?(-1*12000*300*pow(((y-0)/300),3)*exp(-8555.55/x)):0
  )//
macro denvarB( x, y)
  (
    
    (x>555.55)?(-1*4.480E+09*900*pow(((y-600)/900),3)*exp(-20444.44/x)):0
    
  )//
macro denvarC( x, y)
  (
    ((x>5555.55)?(-1*0*1.600E+03*pow(((y-1600)/1600),0)*exp(-0/x)):0)
  )//

// -----------------------------------------------------------------------------
// 2. Surface emissivity vs. local density (0.9 virgin, 0.85 partly charred,
//    0.8 char)
// -----------------------------------------------------------------------------
macro emmisivity(x)
(
    (x<=221.6) ? 0.9:
    ((x>=278.8) ? 0.8 : (0.85))
)//

// -----------------------------------------------------------------------------
// 3. Solid properties of virgin (v) and char (c) material vs. temperature x [K]
//      cp : specific heat [J/kg/K]    k : conductivity [W/m/K]    h : enthalpy [J/kg]
//    Outside the fitted range the values are held constant.  main.edp blends
//    the virgin and char values with the weight wf(rho) defined below.
// -----------------------------------------------------------------------------
// 4. Weight of the virgin material at density x (1 at rhov, 0 at rhoc)
macro wf(x)((1-rhoc/x) / (1-rhoc/rhov))//

macro cpv(x) 
                (
                  (x > 1.67E+03) ? (2.010E+03) : 
                  ((x < 2.556E+02) ? (8.792E+02) :
                   (-4.39E-10*pow(x,4) +2.33E-6*pow(x,3) -0.00481*pow(x,2) +4.80*pow(x,1) -73.8))
                )//
macro kv(x) 
              (
                (x >3.333E+03)?(2.78E+00):   
                ((x < 2.556E+02)?(3.975E-01):
                (-1.26E-14*pow(x,4) +1.75E-10*pow(x,3) -3.22E-7*pow(x,2) +3.30E-4*pow(x,1) +0.332))
              )//

macro hv(x) 
                (
                  (x >3.333E+03) ? (4.813E+06) : 
                  ((x <= 2.556E+02) ? (-8.967E+05) :
                  (22805710 + (-1098268 - 22805710)/(1 + pow((x/7203.023),1.446946))))
                )//

macro cpc(x)
                (
                  (x >2.22E+03) ? (2.152E+03) : 
                  ((x < 2.556E+02) ? (7.327E+02) :
                  (2193.628 + (462.6547 - 2193.628)/(1 + pow((x/571.484),2.174592))))
                )//
macro kc(x) 
              (
                (x >3.333E+03)?(2.318E+00):   
                ((x < 2.556E+02)?(3.975E-01):
                (-1.59E-14*pow(x,4) +2.09E-10*pow(x,3) -4.89E-7*pow(x,2) +5.09E-4*pow(x,1) +0.288))
              )//
macro hc(x) 
                (
                  (x >2.333E+03) ? (5.793E+06) : 
                  ((x < 2.556E+02) ? (-3.216E+04) :
                 (3.97E-8*pow(x,4) -3.62E-4*pow(x,3) +1.24*pow(x,2) +223*pow(x,1) -1.70E5))
                )//

// -----------------------------------------------------------------------------
// 5. Porous-flow properties, linear in the extent of pyrolysis x = alpha
//    (alpha = 0 virgin, alpha = 1 fully charred).  Used by the Darcy solver.
//      kp  : permeability [m^2]      phi : porosity [-]
// -----------------------------------------------------------------------------
real kpv = 1.6e-11, kpc = 2e-11;      // virgin / char permeability
real phiv = 0.8,    phic = 0.85;      // virgin / char porosity
macro kpcal(x) ( kpv*(1-x) + kpc*x )//
macro phical(x) ( phiv*(1-x) + phic*x )//


// -----------------------------------------------------------------------------
// 6. 1-D linear interpolation in a table
//    intrp(Z, X, Y, n): value at Z of the piecewise-linear function through
//    the n points (X[i], Y[i]), X increasing.  Outside [X[0], X[n-1]] the end
//    values are returned (no extrapolation).
// -----------------------------------------------------------------------------
func real intrp(real Z,real[int] X,real[int] Y,int var)
{
real W=0;
    if(Z<=X(0))
        W=Y(0);
    else
    if(Z>=X(var-1))
        W=Y(var-1);

    else
        {for(int i=0;i<var-1;i++)
           {
            if (Z==X(i))
                W=Y(i);
            else
            if (Z>X(i) && Z<X(i+1))
                W=Y(i)+ (Y(i+1)-Y(i))/(X(i+1)-X(i))*(Z-X(i));
            }
        }
return W;
}
