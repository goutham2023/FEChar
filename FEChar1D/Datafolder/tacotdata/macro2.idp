func real intrp2(real Z, real M, real[int] X, real[int] Y, real[int] Y2)
{
    real W = 0;
    int var=3775;
    for (int i = 0; i<var; i++)
    {
        if (Z == X[i] && M == Y[i])
        {
            W = Y2[i];
            break;
        }
    }
    
    return W;
}



//the functions defined are verified
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
func real intrp(real Z,real[int] X,real[int] Y,int var)
{
real W=0;
    if(Z<=X(0))
        W=Y(0);
    else
    if(Z>=X(var-1))
        W=Y(var-1);

    else
        {for(int i=0;i<var-1;i++)
           {
            if (Z==X(i))
                W=Y(i);
            else
            if (Z>X(i) && Z<X(i+1))
                W=Y(i)+ (Y(i+1)-Y(i))/(X(i+1)-X(i))*(Z-X(i));
            }
        }
return W;
}




func real intrpbl(real P, real T,
                 real[int] Pvals2,
                 real[int] Tvals2,
                 real[int,int] F)
{
    int nP = Pvals2.n;
    int nT = Tvals2.n;

    int iP = 0, iT = 0;
    real u = 0, v = 0;

    // ---- Clamp P ----
    if (P <= Pvals2[0]) {
        iP = 0; u = 0;
    }
    else if (P >= Pvals2[nP-1]) {
        iP = nP-2; u = 1;
    }
    else {
        for (int i = 0; i < nP-1; i++) {
            if (Pvals2[i] <= P && P <= Pvals2[i+1]) {
                iP = i;
                u = (P - Pvals2[i]) / (Pvals2[i+1] - Pvals2[i]);
                break;
            }
        }
    }

    // ---- Clamp T ----
    if (T <= Tvals2[0]) {
        iT = 0; v = 0;
    }
    else if (T >= Tvals2[nT-1]) {
        iT = nT-2; v = 1;
    }
    else {
        for (int j = 0; j < nT-1; j++) {
            if (Tvals2[j] <= T && T <= Tvals2[j+1]) {
                iT = j;
                v = (T - Tvals2[j]) / (Tvals2[j+1] - Tvals2[j]);
                break;
            }
        }
    }

    // ---- Bilinear interpolation ----
    real f00 = F(iP,   iT);
    real f10 = F(iP+1, iT);
    real f01 = F(iP,   iT+1);
    real f11 = F(iP+1, iT+1);

    return (1-u)*(1-v)*f00
         + u*(1-v)*f10
         + (1-u)*v*f01
         + u*v*f11;
}


macro ADAPT()
{
   real errh=5e-3,hmax=1e-3,hmin=5e-5,adaptratio=1.2;
   mT11=0.;mT12=0.;mT22=0.;mS11=0.;mS12=0.;mS22=0.;mV11=0.;mV12=0.;mV22=0.;m11=0.;m12=0.;m22=0.;
   adaptmesh(Msh,T,Told,metric=[mT11[],mT12[],mT22[]],nomeshgeneration=1,
            err=errh,hmax=hmax,hmin=hmin,ratio=adaptratio,iso = 0,nbvx=5e5);
   m11=mT11;
   m12=mT12;
   m22=mT22;

   Msh=adaptmesh(Msh,metric=[m11[],m12[],m22[]],nbvx=5e5);

T=T;
Told=Told;
}//

