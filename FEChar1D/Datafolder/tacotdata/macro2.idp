
macro loc(x)(-343*pow(x,2) -0.774*x +0.992)//


macro loc2(x)(-7.51E7*pow(x,6) +201*pow(x,5) +1.72E5*pow(x,4) -0.703*pow(x,3) -331*pow(x,2) +5.49E-4*x +1.01)//

macro loc3(x)(-392*pow(x,2) +6.14E-16*x +0.999)//
