// =============================================================================
// meshsetup.idp
// -----------------------------------------------------------------------------
// 1D mesh
// =============================================================================

real xr = L, xl = 0;
real topower = 2;   // mesh biasing exponent (grading toward x=0, the heated face)

border C0(t = 0, 1) { x = xl + pow(t, topower) * (xr - xl); }
meshL Msh = buildmeshL(C0(ele));


int frontwall = 1;  // ablating/heated face
int backwall  = 2;  // back face (unused directly here, kept for reference)


