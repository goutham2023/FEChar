func real roundToNearest(real input, real[int] values ,int n) {
    real closest = values[0];
    real minDiff = abs(values[0] - input);

    for (int i = 1; i < n; i++) { // Loop from 1 to 24
        real diff = abs(values[i] - input);
        if (diff < minDiff) {
            minDiff = diff;
            closest = values[i];
        }
    }

    return closest;
}





func real intrp2(real Z, real M, real[int] X, real[int] Y, real[int] Y2)
{
    real W = 0;
    int var=3775;
    for (int i = 0; i<var; i++)
    {
        if (Z == X[i] && M == Y[i])
        {
            W = Y2[i];
            break;
        }
    }
    
    return W;
}



//the functions defined are verified
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////
func real intrp(real Z,real[int] X,real[int] Y,int var)
{
real W=0;
    if(Z<=X(0))
        W=Y(0);
    else
    if(Z>=X(var-1))
        W=Y(var-1);

    else
        {for(int i=0;i<var-1;i++)
           {
            if (Z==X(i))
                W=Y(i);
            else
            if (Z>X(i) && Z<X(i+1))
                W=Y(i)+ (Y(i+1)-Y(i))/(X(i+1)-X(i))*(Z-X(i));
            }
        }
return W;
}
macro ADAPT()
{
   real errh=1e-2,hmax=5e-3,hmin=1e-5,adaptratio=1;
   mT11=0.;mT12=0.;mT22=0.;mS11=0.;mS12=0.;mS22=0.;mV11=0.;mV12=0.;mV22=0.;m11=0.;m12=0.;m22=0.;
   adaptmesh(Msh,T,Told,metric=[mT11[],mT12[],mT22[]],nomeshgeneration=1,
            err=errh,hmax=hmax,hmin=hmin,ratio=adaptratio,iso = 0,nbvx=5e5);
   m11=mT11;
   m12=mT12;
   m22=mT22;

   Msh=adaptmesh(Msh,metric=[m11[],m12[],m22[]],nbvx=5e5);

T=T;
Told=Told;
}//

macro savetecplot3(Th,namef,v1in,v2in,v3in,cv1,cv2,cv3,zname)
{
   ofstream ftec(namef+".dat");
   ftec<<"VARIABLES= x y "<<cv1<<" "<<cv2<<" "<<cv3<<endl;
   ftec<<"ZONE T=\""<<zname<<"\", F=FEPOINT, N="<<Th.nv<<", E="<<Th.nt<<", ET=TRIANGLE"<<endl;
   real[int] Thnv(Th.nv);
   for[i,Thnvi:Thnv]
      ftec<<Th(i).x<<" "<<Th(i).y<<" "<<v1in[][i]<<" "<<v2in[][i]<<" "<<v3in[][i]<<endl;
   ftec<<endl;
   /* connectivites */
   real[int] Thnt(Th.nt);
   for[i,Thnti:Thnt]
      ftec<< Th[i][0]+1 <<" "<< Th[i][1]+1 <<" "<< Th[i][2]+1 <<endl;
   cout<<" +++++++++ savetec3var :: file "<<namef+".dat"<<endl;
}
