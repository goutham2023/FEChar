//boundary condition

macro Tnew(x)
(
  (x>=0.1)?1644:300
)//

macro Tnew2(x)  
( 
    (x >= 0.1) ? 1644 : 
    ((x > 0) ? (300 + (x / 0.1) * (1644 - 300)) : 
    300)
)//

macro Tnew3(x) 
(
  (x >= 60.1) ? 300 : 
  ((x >= 60) ? (1644 - ((x - 60) / 0.1) * (1644 - 300)) : 
  ((x >= 0.1) ? 1644 : 
  (300 + (x / 0.1) * (1644 - 300))))
)//



macro reuech(x) 
(
  (x >= 60.1) ? 0 : 
  ((x >= 60) ? (0.3 - ((x - 60) / 0.1) * 0.3) : 
  ((x >= 0.1) ? 0.3 : 
  (0 + (x / 0.1) * 0.3)))
)//



//for ablaiton 3
macro reuech2(x) 
(
  (x >= 40.1) ? 0 : 
  ((x >= 40) ? (0.3 - ((x - 40) / 0.1) * (0.3 - 0)) : 
  ((x >= 0.1) ? 0.3 :
  (0 + (x / 0.1) * (0.3 - 0))))
)//
macro hblg(x) 
(
  (x >= 60.1) ? 0 : 
  ((x >= 60) ? (1.5E6 - ((x - 60) / 0.1) * (1.5E6 - 0)) : 
  ((x >= 0.1) ? 1.5E6 :
  (0 + (x / 0.1) * (1.5E6 - 0))))
)//

//this is for the ablation validation condition
macro hblg2(x) 
(
  (x >= 60.1) ? 0 : 
  ((x >= 60) ? (2.5E7 - ((x - 60) / 0.1) * (2.5E7 - 0)) : 
  ((x >= 0.1) ? 2.5E7 :
  (0 + (x / 0.1) * (2.5E7 - 0))))
)//

macro loc(x)(-343*pow(x,2) -0.774*x +0.992)//


macro loc2(x)(-7.51E7*pow(x,6) +201*pow(x,5) +1.72E5*pow(x,4) -0.703*pow(x,3) -331*pow(x,2) +5.49E-4*x +1.01)//

macro loc3(x)(-392*pow(x,2) +6.14E-16*x +0.999)//
