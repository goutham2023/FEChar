//thermal properties

macro emmisivity(x)
(
    (x<=221.6) ? 0.9:
    ((x>=278.8) ? 0.8 : (0.85))
)//

macro ccal(x,y)
(
    (x==rhov) ? cpv(y) :
    ((x==rhoc) ? cpc(y) : (wf(x)*cpv(y)+(1-wf(x))*cpc(y)))
)// 
macro kcal(x,y)
(
    (x==rhov) ? kv(y) :
    ((x==rhoc) ? kc(y) : (wf(x)*kv(y)+(1-wf(x))*kc(y)))
)// 

macro hbar(temp)((rhov*hv(temp)-rhoc*hc(temp))/(rhov-rhoc))//


// macro wf(x)(x-rhoc)*(1/60)//
macro wf(x)((1-rhoc/x) / (1-rhoc/rhov))//
// macro wf(x)((1 - rhoc/x) * (1/(rhov - rhoc))) //

macro cpv(x) 
                (
                  (x > 1.67E+03) ? (2.010E+03) : 
                  ((x < 2.556E+02) ? (8.792E+02) :
                   (-4.39E-10*pow(x,4) +2.33E-6*pow(x,3) -0.00481*pow(x,2) +4.80*pow(x,1) -73.8))
                )//
macro kv(x) 
              (
                (x >3.333E+03)?(2.78E+00):   
                ((x < 2.556E+02)?(3.975E-01):
                (-1.26E-14*pow(x,4) +1.75E-10*pow(x,3) -3.22E-7*pow(x,2) +3.30E-4*pow(x,1) +0.332))
              )//

macro hv(x) 
                (
                  (x >3.333E+03) ? (4.813E+06) : 
                  ((x <= 2.556E+02) ? (-8.967E+05) :
                  (22805710 + (-1098268 - 22805710)/(1 + pow((x/7203.023),1.446946))))
                )//

macro cpc(x)
                (
                  (x >2.22E+03) ? (2.152E+03) : 
                  ((x < 2.556E+02) ? (7.327E+02) :
                  (2193.628 + (462.6547 - 2193.628)/(1 + pow((x/571.484),2.174592))))
                )//
macro kc(x) 
              (
                (x >3.333E+03)?(2.318E+00):   
                ((x < 2.556E+02)?(3.975E-01):
                (-1.59E-14*pow(x,4) +2.09E-10*pow(x,3) -4.89E-7*pow(x,2) +5.09E-4*pow(x,1) +0.288))
              )//
macro hc(x) 
                (
                  (x >2.333E+03) ? (5.793E+06) : 
                  ((x < 2.556E+02) ? (-3.216E+04) :
                 (3.97E-8*pow(x,4) -3.62E-4*pow(x,3) +1.24*pow(x,2) +223*pow(x,1) -1.70E5))
                )//

