//boundary condition

//Dirichlet Benchmark 1 temp
macro Tnew(x) 
(
  (x >= 60.1) ? 300 : 
  ((x >= 60) ? (1644 - ((x - 60) / 0.1) * (1644 - 300)) : 
  ((x >= 0.1) ? 1644 : 
  (300 + (x / 0.1) * (1644 - 300))))
)//

macro prnew(x) 
(
  101325
)//


//Convective Benchmark 2.1 and 2.2
macro reuechbc(x) 
(
  (x >= 60.1) ? 0 : 
  ((x >= 60) ? (0.3 - ((x - 60) / 0.1) * 0.3) : 
  ((x >= 0.1) ? 0.3 : 
  (0 + (x / 0.1) * 0.3)))
)//

macro hblg(x) 
(
  (x >= 60.1) ? 0 : 
  ((x >= 60) ? (1.5E6 - ((x - 60) / 0.1) * (1.5E6 - 0)) : 
  ((x >= 0.1) ? 1.5E6 :
  (0 + (x / 0.1) * (1.5E6 - 0))))
)//

//Convective high enthalpy  Benchmark 2.3
macro hblg2(x) 
(
  (x >= 60.1) ? 0 : 
  ((x >= 60) ? (2.5E7 - ((x - 60) / 0.1) * (2.5E7 - 0)) : 
  ((x >= 0.1) ? 2.5E7 :
  (0 + (x / 0.1) * (2.5E7 - 0))))
)//



//Convective, prescribed heat flux (bcType=2 -- no B' tables, no reuech)
//Edit this to whatever q(t) [W/m^2] you already have, e.g. from a separate
//aerothermal/CFD analysis, instead of a boundary-layer edge condition.
macro qconvbc(x) 
(
  (x >= 60.1) ? 0 : 
  ((x >= 60) ? (5E5 - ((x - 60) / 0.1) * 5E5) : 
  ((x >= 0.1) ? 5E5 :
  (0 + (x / 0.1) * 5E5)))
)//

//for ablaiton  Benchmark 2.3 with varying pressure
macro reuechbc40(x) 
(
  (x >= 40.1) ? 0.1E-2 : 
  ((x >= 40) ? (0.1 - ((x - 40) / 0.1) * (0.1 - 0.1E-2)) : 
  ((x >= 0.1) ? 0.1 :
  (0.1E-2 + (x / 0.1) * (0.1 - 0.1E-2))))
)//
macro Prcal40(x) 
(
  (x >= 40.1) ? 405.3 : 
  ((x >= 40) ? (10132.5 - ((x - 40) / 0.1) * 10132.5) : 
  ((x >= 0.1) ? 10132.5 : 
  (405.3 + (x / 0.1) *(10132.5- 405.3))))
)//

macro hblg40(x) 
(
  (x >= 40.1) ? 0 : 
  ((x >= 40) ? (2.5E7 - ((x - 40) / 0.1) * (2.5E7 - 0)) : 
  ((x >= 0.1) ? 2.5E7 :
  (0 + (x / 0.1) * (2.5E7 - 0))))
)//

