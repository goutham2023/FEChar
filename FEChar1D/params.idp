    3500.00, 3525.00, 3550.00, 3575.00, 3600.00, 3625.00,
    3650.00, 3675.00, 3700.00, 3725.00, 3750.00, 3775.00,
    3800.00, 3825.00, 3850.00, 3875.00, 3900.00, 3925.00,
    3950.00, 3975.00, 4000.00
];

real[int, int] bcgridP1(NTw, Nbg), hwgridP1(NTw, Nbg), bcgridP2(NTw, Nbg), hwgridP2(NTw, Nbg),
                bcgridP3(NTw, Nbg), hwgridP3(NTw, Nbg), bcgridP4(NTw, Nbg), hwgridP4(NTw, Nbg);

{
    ifstream f1("Datafolder/tacotdata/bc_grid_P0_0010.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f1 >> bcgridP1(i, j);
    ifstream f2("Datafolder/tacotdata/hw_grid_P0_0010.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f2 >> hwgridP1(i, j);

    ifstream f3("Datafolder/tacotdata/bc_grid_P0_0101.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f3 >> bcgridP2(i, j);
    ifstream f4("Datafolder/tacotdata/hw_grid_P0_0101.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f4 >> hwgridP2(i, j);

    ifstream f5("Datafolder/tacotdata/bc_grid_P0_1013.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f5 >> bcgridP3(i, j);
    ifstream f6("Datafolder/tacotdata/hw_grid_P0_1013.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f6 >> hwgridP3(i, j);

    ifstream f7("Datafolder/tacotdata/bc_grid_P1_0132.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f7 >> bcgridP4(i, j);
    ifstream f8("Datafolder/tacotdata/hw_grid_P1_0132.dat");
    for (int i = 0; i < NTw; i++) for (int j = 0; j < Nbg; j++) f8 >> hwgridP4(i, j);
}


// -----------------------------------------------------------------------------
// bilinear interpolation on a (Twall, B') grid -- used by the B' surface
// energy-balance lookup in main.edp (bcType=1 only)
// -----------------------------------------------------------------------------
func real bilinearInterp(real[int, int] grid, real Tval, real Bg) {
    int i = 0, j = 0;
    while (i < NTw - 1 && Twval[i+1] < Tval) i++;
    while (j < Nbg - 1 && bgval[j+1] < Bg) j++;
    real tt = (Tval - Twval[i]) / (Twval[i+1] - Twval[i]);
    real ss = (Bg - bgval[j]) / (bgval[j+1] - bgval[j]);
    return (1-tt)*(1-ss)*grid(i,j) + tt*(1-ss)*grid(i+1,j) +
           (1-tt)*ss*grid(i,j+1) + tt*ss*grid(i+1,j+1);
}
real bc1, bc2, hw1, hw2;
