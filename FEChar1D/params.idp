    1100.00, 1125.00, 1150.00, 1175.00, 1200.00, 1225.00,
    1250.00, 1275.00, 1300.00, 1325.00, 1350.00, 1375.00,
    1400.00, 1425.00, 1450.00, 1475.00, 1500.00, 1525.00,
    1550.00, 1575.00, 1600.00, 1625.00, 1650.00, 1675.00,
    1700.00, 1725.00, 1750.00, 1775.00, 1800.00, 1825.00,
    1850.00, 1875.00, 1900.00, 1925.00, 1950.00, 1975.00,
    2000.00, 2025.00, 2050.00, 2075.00, 2100.00, 2125.00,
    2150.00, 2175.00, 2200.00, 2225.00, 2250.00, 2275.00,
    2300.00, 2325.00, 2350.00, 2375.00, 2400.00, 2425.00,
    2450.00, 2475.00, 2500.00, 2525.00, 2550.00, 2575.00,
    2600.00, 2625.00, 2650.00, 2675.00, 2700.00, 2725.00,
    2750.00, 2775.00, 2800.00, 2825.00, 2850.00, 2875.00,
    2900.00, 2925.00, 2950.00, 2975.00, 3000.00, 3025.00,
