// =============================================================================
// params.idp
// =============================================================================

// -----------------------------------------------------------------------------
// USER CONFIGURATION
// -----------------------------------------------------------------------------
int  bcType       = 1;     // 0 = Dirichlet wall temperature
                           // 1 = Convective/B' (reuech + B'-table ablation chemistry)
                           // 2 = Convective/Q  (prescribed net wall heat flux qconv, no B' tables, no recession)
bool useRadiation = true;  // surface re-radiation on/off   (bcType=1 or 2 only)
bool useAblation  = true;  // surface recession on/off      (bcType=1 only; bcType=2 never recedes)
string casename ="conv";



// -----------------------------------------------------------------------------
// Physical / numerical constants
// -----------------------------------------------------------------------------
real dt   = 0.005;             // timestep [s]
int ele = 500;  // number of mesh elements
real L    = 0.05;              // domain length [m]
real tend = 3;               // end time [s]


real rhov = 280, rhoc = 220;   // virgin / fully-charred density [kg/m3]
real vf2  = 0.5;

func idt = 1./dt;
real Tamb2 = 300; 
real sig  = 5.67E-8;           // Stefan-Boltzmann constant
real vir98 = 278.8;            // density threshold: 98% virgin
real char02 = 221.2;           // density threshold: 2% char remaining
real sum = 0;
real snet = 0;          // cumulative surface recession [m]

// -----------------------------------------------------------------------------
// Material property tables (pyrolysis gas thermodynamics + virgin/char solid)
// -----------------------------------------------------------------------------
int num = 152; int num2 = 3775; int num3 = 115; int num4 = 13;
real[int] TE3(num), Hpref(num), Muref(num), rhogref(num), Mref(num), cpgref(num), gammaref(num);
real[int] bgref(num2), Tref(num2), bcref(num2), Hwref(num2);
real[int] tsurref(num3), Tsurref(num3);
real[int] TE4(num4), cpvref(num4), kvref(num4), hvref(num4), cpcref(num4), kcref(num4), hcref(num4);

{
    ifstream IST("Datafolder/tacotdata/pyrogas_prop.txt");
    for (int i = 0; i < num; i++)
        IST >> TE3[i] >> Mref[i] >> cpgref[i] >> gammaref[i] >> Hpref[i] >> Muref[i] >> rhogref[i];
}
{
    ifstream IST4("Datafolder/tacotdata/materialprop.dat");
    for (int i = 0; i < num4; i++)
        IST4 >> TE4(i) >> cpvref(i) >> kvref(i) >> hvref(i) >> cpcref(i) >> kcref(i) >> hcref(i);
}



// -----------------------------------------------------------------------------
// B' ablation-table data (surface energy-balance grids, bcType=1 only)
// Formerly "input2.pde". Table format: NTw x Nbg grid at each of 4 pressures.
// -----------------------------------------------------------------------------
int Nbg = 25;
int NTw = 151;

real[int] Pvals = [1.01325E2, 1.01325E3, 1.01325E4, 1.01325E5];
int NP = Pvals.n;

real[int] bgval = [0.00, 0.02, 0.04, 0.07, 0.10, 0.15,
                    0.20, 0.25, 0.32, 0.40, 0.50,
                    0.60, 0.70, 0.80, 0.90, 1.00,
                    1.20, 1.50, 1.90, 2.40, 3.00,
                    4.00, 5.50, 7.50, 10.00];

real[int] Twval = [
    250.00, 275.00, 300.00, 325.00, 350.00, 375.00, 400.00,
    425.00, 450.00, 475.00, 500.00, 525.00, 550.00, 575.00,
